{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "printkit desktop",
  "mainBinaryName": "printkit-desktop",
  "version": "0.2.5",
  "identifier": "dev.printkit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "business",
        "title": "printkit",
        "width": 900,
        "height": 633,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/printkit"
    ],
    "category": "Utility",
    "shortDescription": "Local print service console",
    "longDescription": "Start, stop, inspect and administer the local printkit service.",
    "copyright": "printkit contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
