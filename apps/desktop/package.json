{
  "name": "printkit-desktop",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
