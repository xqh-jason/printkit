    "element-plus": "2.14.8",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vue-tsc": "3.3.14"
  }
